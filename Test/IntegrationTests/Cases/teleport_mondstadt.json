{
  "name": "teleport_mondstadt",
  "description": "手柄模式：打开地图 → 放大到最大 → 区域列表选择蒙德 → OCR 确认 → 确认传送",
  "steps": [
    {
      "type": "openMap",
      "modifier": "LeftShoulder",
      "direction": "Down",
      "holdMs": 350,
      "ms": 1500,
      "retries": 3,
      "screenshot": "01_map",
      "description": "LB + 右摇杆↓，重试直到识别到大地图"
    },
    {
      "type": "zoomMax",
      "button": "LeftTrigger",
      "durationMs": 600,
      "ms": 400,
      "attempts": 6,
      "targetScale": 0.97,
      "screenshot": "02_map_max_zoom",
      "description": "LT 放大到最大，确保锚点可见"
    },
    {
      "type": "press",
      "button": "Y",
      "durationMs": 80,
      "ms": 1000,
      "screenshot": "03_region_list",
      "description": "打开区域列表"
    },
    {
      "type": "stick",
      "stick": "Left",
      "x": 0,
      "y": 1,
      "durationMs": 150,
      "repeat": 5,
      "ms": 300,
      "description": "左摇杆向上滚到列表顶部（蒙德）"
    },
    {
      "type": "press",
      "button": "B",
      "durationMs": 80,
      "ms": 1500,
      "screenshot": "04_region_selected",
      "description": "选中区域并跳转默认传送点"
    },
    {
      "type": "ocrAssert",
      "text": "蒙德",
      "description": "OCR 确认画面出现蒙德"
    },
    {
      "type": "press",
      "button": "B",
      "durationMs": 80,
      "ms": 3000,
      "screenshot": "05_teleported",
      "description": "确认传送"
    }
  ]
}
