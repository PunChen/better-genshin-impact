<UserControl x:Class="BetterGenshinImpact.View.Pages.KeyBindingsSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:kb="clr-namespace:BetterGenshinImpact.View.Controls.KeyBindings"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="clr-namespace:BetterGenshinImpact.Model"
             xmlns:pages="clr-namespace:BetterGenshinImpact.ViewModel.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
             d:DataContext="{d:DesignInstance Type=pages:KeyBindingsSettingsPageViewModel}"
             d:DesignHeight="850"
             d:DesignWidth="600"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{StaticResource TextThemeFontFamily}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 自定义 Tab 头：解决深色主题下默认 TabItem 文字与高亮对比度不足的问题 -->
        <Style x:Key="PageTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Margin="0,0,4,0"
                                Padding="16,8"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="4,4,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 手柄按键下拉框不单独定义 Style，直接复用页面其它下拉框的主题样式，避免显式 Style 覆盖主题导致文字/背景对比度异常 -->
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <TabControl Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource PageTabItemStyle}">
            <TabItem Header="{i18n:T 键盘 / 鼠标}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Margin="0,0,0,8"
                                  FontTypography="BodyStrong"
                                  Text="{i18n:T 按键绑定设置}" />
                    <ui:TextBlock Grid.Row="1"
                                  Margin="0,0,0,8"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{i18n:T 此处的按键设置默认对除自动拾取、钓鱼、音游、伐木外的内置功能有效，在设置中打开“启用全局按键映射”开关可对JS脚本、战斗脚本和地图追踪内包含的简易策略脚本生效。请手动设置拾取按键、星之归还按键、隐藏主界面按键。}"
                                  TextWrapping="Wrap" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:TextBlock Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Text="{i18n:T 配置来源}" />
                        <ComboBox Width="110"
                                  Margin="0,0,8,0"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding RegistrySourceOptions}"
                                  SelectedItem="{Binding SelectedRegistrySource, Mode=TwoWay}" />
                        <ui:Button Command="{Binding FetchFromRegistryCommand}"
                                   Content="{i18n:T 从注册表读取}"
                                   Icon="{ui:SymbolIcon Notepad32}" />
                    </StackPanel>

                    <ui:Border Grid.Row="3"
                               Background="{DynamicResource CardBackground}"
                               BorderBrush="{DynamicResource CardBorderBrush}"
                               BorderThickness="1"
                               CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid Margin="4">
                            <ui:Grid ColumnDefinitions="*,135" Visibility="Hidden">
                                <Grid x:Name="TreeColumnStar" Grid.Column="0" />
                            </ui:Grid>
                            <ui:TreeListView BorderThickness="0" ItemsSource="{Binding KeyBindingSettingModels}">
                                <ui:TreeListView.Columns>
                                    <GridViewColumnCollection>
                                        <ui:GridViewColumn Width="{Binding ActualWidth, ElementName=TreeColumnStar}" Header="{i18n:T 动作}">
                                            <ui:GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:TreeRowExpander Content="{Binding ActionName}" />
                                                </DataTemplate>
                                            </ui:GridViewColumn.CellTemplate>
                                        </ui:GridViewColumn>
                                        <ui:GridViewColumn Width="120" Header="{i18n:T 按键绑定}">
                                            <ui:GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <kb:KeyBindingTextBox Padding="16,6,16,6"
                                                                          VerticalAlignment="Center"
                                                                          KeyBinding="{Binding KeyValue}"
                                                                          Style="{StaticResource DefaultTextBoxStyle}"
                                                                          TextAlignment="Center"
                                                                          Visibility="{Binding IsDirectory, Converter={StaticResource BooleanToVisibilityRevertConverter}, Mode=OneWay}" />
                                                </DataTemplate>
                                            </ui:GridViewColumn.CellTemplate>
                                        </ui:GridViewColumn>
                                    </GridViewColumnCollection>
                                </ui:TreeListView.Columns>
                                <ui:TreeListView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}" />
                                </ui:TreeListView.ItemTemplate>
                            </ui:TreeListView>
                        </Grid>
                    </ui:Border>
                </Grid>
            </TabItem>

            <TabItem Header="{i18n:T 手柄}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <ui:ToggleSwitch Content="{i18n:T 启用手柄模式（虚拟 Xbox360 手柄）}"
                                         IsChecked="{Binding GamepadConfig.Enabled, Mode=TwoWay}" />
                        <ui:TextBlock Margin="0,6,0,10"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{i18n:T 手柄模式需要游戏内也切换到手柄控制，并在本软件中同时开启才会生效。依赖 ViGEmBus 驱动。开启后游戏操作优先使用手柄按键，未绑定的动作会被忽略。修改后请重新开始任务以生效。}"
                                      TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Command="{Binding TestGamepadConfirmCommand}"
                                   Content="{i18n:T 测试确认键}" />
                        <ui:Button Command="{Binding ResetGamepadBindingsCommand}"
                                   Content="{i18n:T 恢复默认}"
                                   Margin="8,0,0,0" />
                        <ui:Button Command="{Binding RunGamepadTeleportTestCommand}"
                                   Content="{i18n:T 一键测试：传送到蒙德城}"
                                   Margin="8,0,0,0" />
                        <ui:TextBlock Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{Binding GamepadStatus}"
                                      TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{i18n:T 集成测试日志（同时写入 log/gamepad-integration-test-*.log）}"
                                      TextWrapping="Wrap" />
                        <TextBox Height="120"
                                 Margin="0,4,0,0"
                                 Padding="8"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 Text="{Binding GamepadTestLog, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <ui:Border Grid.Row="3"
                               Padding="8"
                               Background="{DynamicResource CardBackground}"
                               BorderBrush="{DynamicResource CardBorderBrush}"
                               BorderThickness="1"
                               CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="8,4,8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0"
                                              FontTypography="BodyStrong"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{i18n:T 动作}" />
                                <ui:TextBlock Grid.Column="1"
                                              Grid.ColumnSpan="2"
                                              FontTypography="BodyStrong"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{i18n:T 手柄操作}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ui:TextBlock Margin="8,8,8,4"
                                                  FontTypography="BodyStrong"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Text="{i18n:T 快捷轮盘（按住 LB + 右摇杆）}" />
                                    <ItemsControl ItemsSource="{Binding GamepadWheelBindings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="WheelRowBorder"
                                                        Margin="0,1"
                                                        Padding="8,6"
                                                        Background="Transparent"
                                                        CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="170" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   Text="{Binding ActionName}"
                                                                   TextWrapping="Wrap" />
                                                        <ComboBox Grid.Column="1"
                                                                  Height="32"
                                                                  MinWidth="140"
                                                                  Padding="8,4"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalContentAlignment="Center"
                                                                  ItemsSource="{Binding DataContext.GamepadButtons, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                  SelectedItem="{Binding Modifier, Mode=TwoWay}" />
                                                        <ComboBox Grid.Column="2"
                                                                  Height="32"
                                                                  MinWidth="140"
                                                                  Padding="8,4"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalContentAlignment="Center"
                                                                  ItemsSource="{Binding DataContext.GamepadDirections, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                  SelectedItem="{Binding Direction, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="WheelRowBorder" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="WheelRowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ui:TextBlock Margin="8,12,8,4"
                                                  FontTypography="BodyStrong"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Text="{i18n:T 直接按键 / 组合键}" />

                                    <ItemsControl ItemsSource="{Binding GamepadBindingModels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RowBorder"
                                                        Margin="0,1"
                                                        Padding="8,6"
                                                        Background="Transparent"
                                                        CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="170" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   Text="{Binding ActionName}"
                                                                   TextWrapping="Wrap" />
                                                        <ComboBox Grid.Column="1"
                                                                  Grid.ColumnSpan="2"
                                                                  Height="32"
                                                                  MinWidth="180"
                                                                  Padding="8,4"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalContentAlignment="Center"
                                                                  ItemsSource="{Binding DataContext.GamepadButtons, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                  SelectedItem="{Binding ButtonValue, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </ui:Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
